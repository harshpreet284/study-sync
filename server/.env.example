# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g. mongodb://localhost:27017/studysync)
MONGODB_URI=mongodb://localhost:27017/studysync

# Isolated Test Database Connection
# Required for running integration tests. Must point to a dedicated test database named studysync_test.
# Tests will safely fail/abort before writes if this variable is missing or points to the development database.
MONGODB_TEST_URI=mongodb://localhost:27017/studysync_test

# Client Origin (for CORS)
# Supports a single origin or comma-separated origins (e.g. https://app.example.com,https://staging.example.com)
CLIENT_URL=http://localhost:5173

# Authentication (JWT)
# Generate a strong secret (e.g. 64-character random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# AI Study Planner Configuration (Groq / Mock)
# Set AI_PROVIDER to 'mock' for local deterministic offline testing, or 'groq' for live AI generation.
# When NODE_ENV === 'test' or AI_PROVIDER === 'mock', local deterministic mock output is generated without external network calls.
AI_PROVIDER=mock

# Groq API Configuration (required when AI_PROVIDER is 'groq')
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model ID (optional, defaults to openai/gpt-oss-20b which supports token-level strict JSON schema)
GROQ_MODEL=openai/gpt-oss-20b
