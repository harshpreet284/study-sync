# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g. mongodb://localhost:27017/studysync)
MONGODB_URI=mongodb://localhost:27017/studysync

# Isolated Test Database Connection
# Required for running integration tests. Must point to a dedicated test database named studysync_test.
# Tests will safely fail/abort before writes if this variable is missing or points to the development database.
MONGODB_TEST_URI=mongodb://localhost:27017/studysync_test

# Client Origin (for CORS)
# Supports a single origin or comma-separated origins (e.g. https://app.example.com,https://staging.example.com)
CLIENT_URL=http://localhost:5173

# Authentication (JWT)
# Generate a strong secret (e.g. 64-character random string)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d
